generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum BillingInterval {
  MONTH
  YEAR
  // One-time purchase (e.g. a lifetime deal): checkout runs in "payment" mode
  // and the grant is recorded as a Purchase instead of a Subscription.
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
  INCOMPLETE
}

enum PurchaseStatus {
  COMPLETED
  REFUNDED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  // Set only for email+password accounts (bcrypt). OAuth/magic-link users
  // have null here until they add a password from Settings.
  passwordHash        String?
  role                Role                 @default(USER)
  stripeCustomerId    String?              @unique
  // Bumped on password reset; JWTs carrying an older version are rejected,
  // so a reset revokes every other session (JWTs are otherwise unrevocable).
  sessionVersion      Int                  @default(1)
  // When the user dismissed the "Get started" checklist; the checklist items
  // themselves are derived live (name, projects, billing), only this persists.
  onboardingDismissedAt DateTime?
  accounts            Account[]
  sessions            Session[]
  subscription        Subscription?
  purchases           Purchase[]
  projects            Project[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Single-use tokens for the "forgot password" flow. The raw token only ever
// travels in the emailed link; the DB stores its SHA-256 hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Plan {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String?
  price         Int
  interval      BillingInterval
  stripePriceId String          @unique
  // Set only on metered (usage-based) plans: the Stripe Billing Meter event
  // name that recordUsage() reports against. Metered prices must be checked
  // out without a quantity.
  meterEventName String?
  features      String[]
  isActive      Boolean         @default(true)
  subscriptions Subscription[]
  purchases     Purchase[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// One-time payments (ONE_TIME plans). The PaymentIntent id is the idempotency
// key for the webhook: replays find the existing row and no-op. userId is not
// unique on purpose — a real product may sell several one-time items.
model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  planId                  String
  stripePaymentIntentId   String         @unique
  stripeCheckoutSessionId String?        @unique
  amount                  Int
  currency                String         @default("usd")
  status                  PurchaseStatus @default(COMPLETED)
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                    Plan           @relation(fields: [planId], references: [id])
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([userId])
}

// ─── Example domain resource ──────────────────────────────────────────────────
// The core "thing" users create and own. It's the base CRUD pattern to copy when
// building your own features — and the foundation teams/multi-tenancy builds on
// (in the Pro tier, a Project belongs to a Team instead of a single User).
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
