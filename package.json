{
  "name": "openstarterkit",
  "version": "2.4.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-migration-manifest.mjs",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "check:deploy": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-deploy.mjs",
    "db:seed": "dotenv -e .env.local -- ts-node prisma/seed.ts",
    "db:seed:demo": "dotenv -e .env.local -- ts-node prisma/seed-demo.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.12",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@stripe/stripe-js": "^10.1.0",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.24.3",
    "gray-matter": {
      "js-yaml": {
        "argparse": "^2.0.1"
      }
    }
  }
}
